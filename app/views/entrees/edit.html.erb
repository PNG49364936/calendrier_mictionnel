<div class="mb-4">
  <h1>
    <i class="bi bi-pencil-square text-primary me-2"></i>
    Modifier l'entree
  </h1>
  <p class="text-muted fs-5">
    Journee du <%= @journee_observation.date_observation.strftime("%d/%m/%Y") %>
  </p>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= render "form", entree: @entree, journee_observation: @journee_observation %>
  </div>
</div>

<div class="mt-3">
  <%= link_to journee_observation_path(@journee_observation), class: "btn btn-outline-secondary btn-lg" do %>
    <i class="bi bi-arrow-left me-1"></i> Retour a la journee
  <% end %>
</div>
