<!-- Action Buttons -->
<div class="text-center mb-5">
  <h1 class="mb-4">
    <i class="bi bi-calendar2-heart text-primary me-2"></i>
    Calendrier Mictionnel
  </h1>

  <div class="row justify-content-center g-3">
    <div class="col-auto">
      <%= link_to new_journee_observation_path, class: "btn btn-primary btn-action shadow" do %>
        <i class="bi bi-plus-circle"></i> Nouveau formulaire
      <% end %>
    </div>
    <div class="col-auto">
      <% if @journee_en_cours&.en_cours? %>
        <%= link_to journee_observation_path(@journee_en_cours), class: "btn btn-success btn-action shadow" do %>
          <i class="bi bi-pencil-square"></i> Formulaire en cours
        <% end %>
      <% else %>
        <button class="btn btn-secondary btn-action shadow" disabled title="Aucun formulaire en cours aujourd'hui">
          <i class="bi bi-pencil-square"></i> Formulaire en cours
        </button>
      <% end %>
    </div>
    <div class="col-auto">
      <%= link_to resultats_path, class: "btn btn-info btn-action shadow text-white" do %>
        <i class="bi bi-bar-chart-line"></i> Voir les resultats
      <% end %>
    </div>
  </div>
</div>

<!-- List of journées -->
<% if @journees.any? %>
  <h2 class="mb-3">
    <i class="bi bi-journal-text me-2"></i>
    Journees enregistrees
  </h2>

  <div class="row g-3">
    <% @journees.each do |journee| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card card-journee shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0">
                <i class="bi bi-calendar-date me-1 text-primary"></i>
                <%= journee.date_observation.strftime("%d/%m/%Y") %>
              </h5>
              <% if journee.en_cours? %>
                <span class="badge bg-success badge-en-cours">En cours</span>
              <% end %>
            </div>

            <div class="mb-3">
              <p class="card-text mb-1">
                <i class="bi bi-sunrise text-warning me-1"></i>
                <strong>Lever :</strong> <%= journee.heure_lever&.strftime("%H:%M") || "Non renseigne" %>
              </p>
              <p class="card-text mb-1">
                <i class="bi bi-moon text-info me-1"></i>
                <strong>Coucher :</strong> <%= journee.heure_coucher&.strftime("%H:%M") || "Non renseigne" %>
              </p>
              <p class="card-text mb-0">
                <i class="bi bi-list-check text-secondary me-1"></i>
                <strong>Entrees :</strong> <%= journee.entrees.count %>
              </p>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 pb-3">
            <div class="d-flex gap-2">
              <%= link_to journee_observation_path(journee), class: "btn btn-outline-primary btn-sm flex-fill" do %>
                <i class="bi bi-eye me-1"></i> Voir
              <% end %>
              <%= link_to edit_journee_observation_path(journee), class: "btn btn-outline-secondary btn-sm flex-fill" do %>
                <i class="bi bi-pencil me-1"></i> Modifier
              <% end %>
              <%= link_to journee_observation_path(journee), data: { turbo_method: :delete, turbo_confirm: "Etes-vous sur de vouloir supprimer cette journee et toutes ses entrees ?" }, class: "btn btn-outline-danger btn-sm" do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-5">
    <i class="bi bi-journal-x text-muted" style="font-size: 3rem;"></i>
    <p class="text-muted mt-3 fs-5">Aucune journee d'observation enregistree.</p>
    <p class="text-muted">Cliquez sur "Nouveau formulaire" pour commencer.</p>
  </div>
<% end %>
