<div class="mb-4">
  <h1>
    <i class="bi bi-pencil-square text-primary me-2"></i>
    Modifier la journee du <%= @journee_observation.date_observation&.strftime("%d/%m/%Y") %>
  </h1>
  <p class="text-muted fs-5">Modifiez les informations de cette journee d'observation.</p>
</div>

<%= render "form", journee_observation: @journee_observation %>

<div class="mt-3">
  <%= link_to journee_observation_path(@journee_observation), class: "btn btn-outline-secondary btn-lg" do %>
    <i class="bi bi-arrow-left me-1"></i> Retour a la journee
  <% end %>
</div>
