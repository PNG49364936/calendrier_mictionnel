<!-- Header with day info -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
      <div>
        <h1 class="mb-2">
          <i class="bi bi-calendar-date text-primary me-2"></i>
          Journee du <%= @journee_observation.date_observation.strftime("%d/%m/%Y") %>
          <% if @journee_observation.en_cours? %>
            <span class="badge bg-success badge-en-cours ms-2 fs-6">En cours</span>
          <% end %>
        </h1>
        <div class="d-flex flex-wrap gap-4 fs-5">
          <span>
            <i class="bi bi-sunrise text-warning me-1"></i>
            <strong>Lever :</strong> <%= @journee_observation.heure_lever&.strftime("%H:%M") || "Non renseigne" %>
          </span>
          <span>
            <i class="bi bi-moon text-info me-1"></i>
            <strong>Coucher :</strong> <%= @journee_observation.heure_coucher&.strftime("%H:%M") || "Non renseigne" %>
          </span>
        </div>
      </div>
      <div class="mt-2 mt-md-0">
        <%= link_to edit_journee_observation_path(@journee_observation), class: "btn btn-outline-primary" do %>
          <i class="bi bi-pencil me-1"></i> Modifier la journee
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Entries table -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white">
    <h2 class="mb-0 fs-4">
      <i class="bi bi-list-check me-2 text-primary"></i>
      Entrees
    </h2>
  </div>
  <div class="card-body p-0">
    <% if @journee_observation.entrees.any? %>
      <div class="table-responsive">
        <table class="table table-entries table-bordered table-hover mb-0">
          <thead>
            <tr>
              <th>Heure</th>
              <th>Boisson (ml)</th>
              <th>Urine (ml)</th>
              <th>Intervalle (min)</th>
              <th>Urgenturies</th>
              <th>Fuites</th>
              <th>Commentaires</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @journee_observation.entrees.order(:heure).each do |entree| %>
              <tr>
                <td><%= entree.heure.strftime("%H:%M") %></td>
                <td><%= entree.volume_boisson || "-" %></td>
                <td><%= entree.volume_urine || "-" %></td>
                <td><%= entree.intervalle_mictionnel ? "#{entree.intervalle_mictionnel} min" : "-" %></td>
                <td><%= entree.urgenturies.presence || "-" %></td>
                <td><%= entree.fuites.presence || "-" %></td>
                <td><%= entree.commentaires.presence || "-" %></td>
                <td class="text-center">
                  <div class="btn-group btn-group-sm">
                    <%= link_to edit_journee_observation_entree_path(@journee_observation, entree), class: "btn btn-outline-secondary" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to journee_observation_entree_path(@journee_observation, entree), data: { turbo_method: :delete, turbo_confirm: "Supprimer cette entree ?" }, class: "btn btn-outline-danger" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="row-total">
              <td><strong>Total</strong></td>
              <td><strong><%= @journee_observation.total_boissons %></strong></td>
              <td><strong><%= @journee_observation.total_urine %></strong></td>
              <td></td>
              <td colspan="4"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="text-center py-4">
        <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
        <p class="text-muted mt-2 mb-0 fs-5">Aucune entree pour cette journee.</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Add entry form -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white">
    <h3 class="mb-0 fs-4">
      <i class="bi bi-plus-lg me-2 text-success"></i>
      Ajouter une entree
    </h3>
  </div>
  <div class="card-body">
    <%= render "entrees/form", entree: @entree, journee_observation: @journee_observation %>
  </div>
</div>

<!-- Back button -->
<div class="mt-3">
  <%= link_to journee_observations_path, class: "btn btn-outline-secondary btn-lg" do %>
    <i class="bi bi-arrow-left me-1"></i> Retour a l'accueil
  <% end %>
</div>
