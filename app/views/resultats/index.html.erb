<div class="mb-4">
  <h1>
    <i class="bi bi-bar-chart-line text-primary me-2"></i>
    Resultats
  </h1>
  <p class="text-muted fs-5">Selectionnez les dates pour afficher les resultats.</p>
</div>

<!-- Date selection -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white">
    <h5 class="mb-0">
      <i class="bi bi-calendar-check me-2"></i>
      Dates disponibles
    </h5>
  </div>
  <div class="card-body">
    <% if @dates_disponibles.any? %>
      <%= form_tag resultats_path, method: :get do %>
        <div class="row g-2 mb-3">
          <% @dates_disponibles.each do |date| %>
            <div class="col-auto">
              <div class="form-check form-check-inline">
                <%= check_box_tag "dates[]", date, @selected_dates.include?(date.to_s), class: "form-check-input", id: "date_#{date}", style: "width: 1.3em; height: 1.3em;" %>
                <%= label_tag "date_#{date}", date.strftime("%d/%m/%Y"), class: "form-check-label fs-5 ms-1" %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="d-flex gap-2">
          <%= submit_tag "Afficher les resultats", class: "btn btn-primary btn-lg" %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-3">
        <i class="bi bi-journal-x text-muted" style="font-size: 2.5rem;"></i>
        <p class="text-muted mt-2 mb-0 fs-5">Aucune journee d'observation enregistree.</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Results tables -->
<% if @journees.any? %>
  <% @journees.each do |journee| %>
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
          <i class="bi bi-calendar-date me-2"></i>
          <%= journee.date_observation.strftime("%d/%m/%Y") %>
          <span class="ms-3 fw-normal fs-6">
            <i class="bi bi-sunrise me-1"></i> Lever : <%= journee.heure_lever&.strftime("%H:%M") || "-" %>
            <span class="mx-2">|</span>
            <i class="bi bi-moon me-1"></i> Coucher : <%= journee.heure_coucher&.strftime("%H:%M") || "-" %>
          </span>
        </h4>
      </div>
      <div class="card-body p-0">
        <% if journee.entrees.any? %>
          <div class="table-responsive">
            <table class="table table-entries table-bordered table-hover mb-0">
              <thead>
                <tr>
                  <th>Heure</th>
                  <th>Boisson (ml)</th>
                  <th>Urine (ml)</th>
                  <th>Intervalle (min)</th>
                  <th>Urgenturies</th>
                  <th>Fuites</th>
                  <th>Commentaires</th>
                </tr>
              </thead>
              <tbody>
                <% journee.entrees.order(:heure).each do |entree| %>
                  <tr>
                    <td><%= entree.heure.strftime("%H:%M") %></td>
                    <td><%= entree.volume_boisson || "-" %></td>
                    <td><%= entree.volume_urine || "-" %></td>
                    <td><%= entree.intervalle_mictionnel ? "#{entree.intervalle_mictionnel} min" : "-" %></td>
                    <td><%= entree.urgenturies.presence || "-" %></td>
                    <td><%= entree.fuites.presence || "-" %></td>
                    <td><%= entree.commentaires.presence || "-" %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr class="row-total">
                  <td><strong>Total du jour</strong></td>
                  <td><strong><%= journee.total_boissons %></strong></td>
                  <td><strong><%= journee.total_urine %></strong></td>
                  <td></td>
                  <td colspan="3"></td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% else %>
          <div class="text-center py-3">
            <p class="text-muted mb-0"><em>Aucune entree pour cette journee.</em></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Global total -->
  <% if @journees.size > 1 %>
    <div class="card shadow-sm mb-4 border-primary">
      <div class="card-body p-0">
        <table class="table table-bordered mb-0">
          <thead>
            <tr class="row-total-global">
              <th>Total Global</th>
              <th>Boissons (ml)</th>
              <th>Urine (ml)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="row-total-global">
              <td><strong><%= @journees.size %> journees</strong></td>
              <td><strong><%= @total_global_boissons %></strong></td>
              <td><strong><%= @total_global_urine %></strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Statistiques détaillées -->
  <% if @stats %>
    <div class="card shadow-sm mb-4 border-info">
      <div class="card-header stats-header">
        <h5 class="mb-0">
          <i class="bi bi-graph-up me-2"></i>
          Statistiques
        </h5>
      </div>
      <div class="card-body">

        <%# 1. Moyenne miction %>
        <div class="stats-section mb-4">
          <h6 class="stats-section-title">
            <i class="bi bi-calculator me-2"></i>Moyenne miction
          </h6>
          <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0">
              <thead>
                <tr class="stats-table-header">
                  <th>Date</th>
                  <th>Volume quotidien (ml)</th>
                  <th>Nb mictions</th>
                  <th>Moyenne (ml)</th>
                  <th>Moyenne intervalle (min)</th>
                </tr>
              </thead>
              <tbody>
                <% @stats[:moyennes_par_jour].each do |m| %>
                  <tr>
                    <td><%= m[:date] %></td>
                    <td><%= @journees.find { |j| j.date_observation.strftime("%d/%m/%Y") == m[:date] }&.total_urine %></td>
                    <td><%= m[:nb_mictions] %></td>
                    <td><strong><%= m[:moyenne] %> ml</strong></td>
                    <td><strong><%= m[:moyenne_intervalle] > 0 ? "#{m[:moyenne_intervalle]} min" : "-" %></strong></td>
                  </tr>
                <% end %>
                <% if @stats[:moyennes_par_jour].size > 1 %>
                  <tr class="row-total">
                    <td><strong>Global</strong></td>
                    <td><strong><%= @total_global_urine %></strong></td>
                    <td><strong><%= @stats[:nb_mictions_global] %></strong></td>
                    <td><strong><%= @stats[:moyenne_globale] %> ml</strong></td>
                    <td><strong><%= @stats[:moyenne_intervalle_global] > 0 ? "#{@stats[:moyenne_intervalle_global]} min" : "-" %></strong></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%# 2. Volume miction min / max %>
        <div class="stats-section mb-4">
          <h6 class="stats-section-title">
            <i class="bi bi-arrows-expand me-2"></i>Volumes extrêmes
          </h6>
          <div class="row g-3">
            <div class="col-md-6">
              <div class="stats-card stats-card-min">
                <div class="stats-card-icon">
                  <i class="bi bi-arrow-down-circle"></i>
                </div>
                <div class="stats-card-content">
                  <span class="stats-card-label">Volume minimum</span>
                  <span class="stats-card-value"><%= @stats[:miction_min][:volume] %> ml</span>
                  <span class="stats-card-detail">le <%= @stats[:miction_min][:date] %></span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="stats-card stats-card-max">
                <div class="stats-card-icon">
                  <i class="bi bi-arrow-up-circle"></i>
                </div>
                <div class="stats-card-content">
                  <span class="stats-card-label">Volume maximum</span>
                  <span class="stats-card-value"><%= @stats[:miction_max][:volume] %> ml</span>
                  <span class="stats-card-detail">le <%= @stats[:miction_max][:date] %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%# 3. Top 3 écarts entre mictions %>
        <% if @stats[:top_ecarts].any? %>
          <div class="stats-section">
            <h6 class="stats-section-title">
              <i class="bi bi-clock-history me-2"></i>3 plus grands écarts entre mictions
            </h6>
            <div class="table-responsive">
              <table class="table table-bordered table-sm mb-0">
                <thead>
                  <tr class="stats-table-header">
                    <th>#</th>
                    <th>Date</th>
                    <th>De</th>
                    <th>À</th>
                    <th>Écart (min)</th>
                    <th>Volume miction (ml)</th>
                  </tr>
                </thead>
                <tbody>
                  <% @stats[:top_ecarts].each_with_index do |ecart, i| %>
                    <tr>
                      <td><span class="badge stats-badge-rank"><%= i + 1 %></span></td>
                      <td><%= ecart[:date] %></td>
                      <td><%= ecart[:heure1] %></td>
                      <td><%= ecart[:heure2] %></td>
                      <td><strong><%= ecart[:minutes] %> min</strong></td>
                      <td><%= ecart[:volume] %> ml</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  <% end %>

  <!-- PDF Export -->
  <div class="text-center mb-4">
    <%= link_to resultats_pdf_path(dates: @selected_dates), class: "btn btn-success btn-lg px-5 shadow", target: "_blank" do %>
      <i class="bi bi-file-earmark-pdf me-2"></i> Exporter en PDF
    <% end %>
  </div>
<% end %>

<!-- Back button -->
<div class="mt-3">
  <%= link_to root_path, class: "btn btn-outline-secondary btn-lg" do %>
    <i class="bi bi-arrow-left me-1"></i> Retour a l'accueil
  <% end %>
</div>
